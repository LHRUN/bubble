{
  "name": "bubble",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:script": "eslint --ext .js,.jsx,.ts,.tsx --fix --quiet ./",
    "lint:style": "stylelint --fix \"src/**/*.scss\"",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.6.0",
    "@vercel/analytics": "^1.1.1",
    "classnames": "^2.3.2",
    "next": "15.5.25",
    "next-auth": "^4.24.15",
    "react": "^18",
    "react-dom": "^18",
    "swr": "^2.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.2.0",
    "@commitlint/config-conventional": "^18.1.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.52.0",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.2",
    "prettier": "^3.0.3",
    "prisma": "^5.6.0",
    "sass": "^1.69.5",
    "stylelint": "^15.11.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^4.3.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,tsx,ts}": [
      "pnpm lint:script"
    ],
    "*.{scss}": [
      "pnpm lint:style"
    ]
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=4.0.0 <4.1.1": "4.1.1",
      "lodash@>=4.0.0 <=4.17.22": "4.17.23",
      "minimatch@>=3.0.0 <3.1.3": "3.1.3",
      "immutable@>=4.0.0-rc.1 <4.3.8": "4.3.8",
      "flatted@>=3.0.0 <=3.4.1": "3.4.2",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "braces@>=3.0.0 <3.0.3": "3.0.3",
      "postcss@>=8.0.0 <8.5.10": "8.5.10",
      "brace-expansion@>=1.0.0 <1.1.16": "1.1.16",
      "nanoid@>=3.0.0 <3.3.16": "3.3.16"
    }
  }
}
